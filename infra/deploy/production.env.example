# Template for infra/deploy/production.env (never commit the real file).
# Deploy: docker compose --env-file infra/deploy/production.env -f infra/docker/compose.prod.yaml up -d
NODE_ENV=production
PUBLIC_ISSUER=https://id.nexora-studios.tech
ACCOUNTS_BASE_URL=https://accounts.nexora-studios.tech

# Postgres (generated, high-entropy)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=nexora_idp
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# 32+ crypto-random bytes
SESSION_SECRET=

# Vault AppRole (bootstrap via one-time token; see docs/deployment.md §3)
VAULT_APPROLE_ROLE_ID=
VAULT_APPROLE_SECRET_ID=
SIGNING_KEY_REFERENCE=secret/data/nexora-idp/signing

# Vault unseal (N-of-3 key shares; stored only in this host env file, mode 600)
VAULT_UNSEAL_KEY_1=
VAULT_UNSEAL_KEY_2=
VAULT_UNSEAL_KEY_3=

# SMTP provider
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
