# Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PUBLIC_ISSUER=https://id.nexora-studios.tech
ACCOUNTS_BASE_URL=https://accounts.nexora-studios.tech

DATABASE_URL=postgres://nexora:nexora_dev_only@localhost:5432/nexora_idp

# Session cookie secret (crypto-safe random, 32+ bytes)
SESSION_SECRET=

# Vault (dev compose: root token is dev-root-token)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
SIGNING_KEY_REFERENCE=secret/data/nexora-idp/signing

# Email (dev: Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
