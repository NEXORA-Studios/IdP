{
  "name": "nexora-idp",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @nexora/db migrate",
    "db:generate": "pnpm --filter @nexora/db generate"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "eslint": "^9.30.0",
    "typescript-eslint": "^8.35.0"
  }
}
